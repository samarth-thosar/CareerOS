# Secrets and environment-specific overrides only -- domain tunables live in config/default.yaml.
# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

CAREEROS_DATABASE_URL=sqlite+aiosqlite:///./careeros.db
CAREEROS_LLM__BASE_URL=http://localhost:11434

# Populated when the Email module (Phase 10) and WhatsApp module (Phase 11) are implemented:
# CAREEROS_GMAIL__CREDENTIALS_PATH=
# CAREEROS_WHATSAPP__... (adapter choice made explicitly with the user at Phase 11; see
#   docs/architecture/decisions/0005-zero-paid-services-constraint.md)
